# ==========================================
# SYSTEM CONFIGURATION (Vite)
# ==========================================
# Application identification
VITE_APP_NAME=CoreLogic Studio
VITE_APP_VERSION=7.0
VITE_APP_BUILD=0

# UI Rendering
VITE_DEFAULT_THEME=Graphite
VITE_FPS_LIMIT=60

# Splash screen
VITE_SPLASH_ENABLED=true
VITE_SPLASH_DURATION=1000
VITE_SPLASH_SIMULATION=true

# Window dimensions
VITE_WINDOW_WIDTH=1600
VITE_WINDOW_HEIGHT=900
VITE_MIN_WINDOW_WIDTH=640
VITE_MIN_WINDOW_HEIGHT=480

# ==========================================
# DISPLAY CONFIGURATION (Vite)
# ==========================================
# Analog console view settings
VITE_CHANNEL_COUNT=10
VITE_CHANNEL_WIDTH=120
VITE_CHANNEL_MIN_WIDTH=80
VITE_CHANNEL_MAX_WIDTH=200

# VU meter refresh rate (milliseconds)
VITE_VU_REFRESH=150

# Rack behavior
VITE_RACK_COLLAPSED=false
VITE_RACK_WIDTH_EXPANDED=300
VITE_RACK_WIDTH_COLLAPSED=60

# Visual elements
VITE_SHOW_WATERMARK=true
VITE_SHOW_GRID=true
VITE_GRID_SIZE=8

# ==========================================
# THEME CONFIGURATION (Vite)
# ==========================================
# Available themes: Dark, Light, Graphite, Neon
VITE_DEFAULT_THEME=Graphite
VITE_ROTARY_CENTER=0.5
VITE_ROTARY_MIN=-1
VITE_ROTARY_MAX=1

# Animation settings (milliseconds)
VITE_TRANSITION_DURATION=200
VITE_HOVER_TRANSITION=100

# ==========================================
# AUDIO CONFIGURATION
# ==========================================
# Default sample rate (Hz)
VITE_DEFAULT_SAMPLE_RATE=44100

# Default buffer size
VITE_DEFAULT_BUFFER_SIZE=512

# Default BPM
VITE_DEFAULT_BPM=120

# Max tracks
VITE_MAX_TRACKS=256

# ==========================================
# DEBUG CONFIGURATION (Vite)
# ==========================================
# Log level: debug | info | warn | error
VITE_LOG_LEVEL=info
VITE_SHOW_PERF_MONITOR=false
VITE_SHOW_LAYOUT_GUIDES=false
VITE_REDUX_DEVTOOLS=true
VITE_MOCK_AUDIO=false

# ==========================================
# BACKEND SERVICES CONFIGURATION (Python)
# ==========================================
# Codette AI Model Configuration
# ==========================================
# Model ID or path - can be:
#   - "gpt2-large" (default HuggingFace model)
#   - Local path to model: "C:/path/to/model" or "/home/user/model"
#   - HuggingFace model ID: "facebook/opt-350m"
#   - Kaggle Hub model: "path/to/downloaded/kaggle/model"
CODETTE_MODEL_ID=C:\Users\Jonathan\.cache\kagglehub\models\jonathanharrison1\codette2\other\v3\5

# Optional: Kaggle Hub model path (download using download_codette_model.py)
# CODETTE_MODEL_PATH=

CODETTE_PORT=8000
CODETTE_HOST=0.0.0.0

# Optional: HuggingFace API Token (for private models or rate limiting)
# HUGGINGFACEHUB_API_TOKEN=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

# Optional: Google Search Integration
# GOOGLE_API_KEY=
# GOOGLE_CUSTOM_SEARCH_ID=

# ==========================================
# CODETTE AI CONFIGURATION
# ==========================================
# Codette connection type
VITE_CODETTE_CONNECTION_TYPE=rest

# Codette health check interval (milliseconds)
VITE_CODETTE_HEALTH_CHECK_INTERVAL=30000

# Enable/disable Codette features
VITE_CODETTE_ENABLED=true
VITE_CODETTE_AUTO_ANALYZE=true
VITE_CODETTE_AUTO_SYNC=true

# Codette perspectives to enable
VITE_CODETTE_PERSPECTIVES_ENABLED=neuralnets,newtonian,davinci,quantum

# Default perspective
VITE_CODETTE_DEFAULT_PERSPECTIVE=davinci

# ==========================================
# INTEGRATION FEATURES
# ==========================================
# Enable Codette AI suggestions
VITE_ENABLE_CODETTE_SUGGESTIONS=true

# Enable audio analysis
VITE_ENABLE_AUDIO_ANALYSIS=true

# Enable effect chain optimization
VITE_ENABLE_EFFECT_OPTIMIZATION=true

# Enable DAW state sync to Codette
VITE_ENABLE_DAW_SYNC=true

